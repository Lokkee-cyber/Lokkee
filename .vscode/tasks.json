		{
			"label": "Check sitemap output integrity",
			"type": "shell",
			"command": "py.exe",
			"args": [
				"-c",
				"import json,pathlib,xml.etree.ElementTree as ET; root=ET.parse('public/sitemap.xml').getroot(); ns={'s':'http://www.sitemaps.org/schemas/sitemap/0.9'}; urls=[e.text for e in root.findall('s:url/s:loc',ns)]; robots=pathlib.Path('public/robots.txt').read_text(); config=json.loads(pathlib.Path('vercel.json').read_text()); assert urls and len(urls)==len(set(urls)); assert all(u.startswith('https://www.toolpillot.com/') for u in urls); assert not any('localhost' in u or '/api/' in u or '/search' in u or '/admin' in u for u in urls); assert 'Sitemap: https://www.toolpillot.com/sitemap.xml' in robots and 'Disallow: /api/' in robots; assert pathlib.Path('dist/sitemap.xml').read_bytes()==pathlib.Path('public/sitemap.xml').read_bytes(); assert pathlib.Path('dist/robots.txt').read_bytes()==pathlib.Path('public/robots.txt').read_bytes(); assert 'sitemap\\\\\\\\.xml$' in config['rewrites'][0]['source'] and 'robots\\\\\\\\.txt$' in config['rewrites'][0]['source']; headers={rule['source']: {h['key']:h['value'] for h in rule['headers']} for rule in config['headers']}; assert headers['/sitemap.xml']['Content-Type'].startswith('application/xml') and headers['/robots.txt']['Content-Type'].startswith('text/plain'); print('PASS: XML is well-formed; '+str(len(urls))+' unique canonical public URLs; robots and Vercel static responses are configured.')"
			],
			"isBackground": false,
			"problemMatcher": []
		},
