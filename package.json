    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "build:production": "npm run generate:sitemap && vite build",
    "server": "node server/index.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
