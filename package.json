{
  "name": "lokkee",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin-api": "node scripts/local-content-server.mjs",
    "automation:scheduler": "node scripts/run-scheduled-content-update.mjs",
    "build": "npm run generate:sitemap && vite build && node scripts/prerender-articles.mjs",
    "preview": "vite preview",
